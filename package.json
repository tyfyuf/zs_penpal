{
  "name": "penpal",
  "version": "0.1.0",
  "description": "Penpal - desktop writing assistant for creators: assists decisions without replacing the creator work",
  "main": "./out/main/index.js",
  "author": "Penpal",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist": "npm run verify:embedding-model && electron-vite build && electron-builder --win",
    "dist:dir": "npm run verify:embedding-model && electron-vite build && electron-builder --win --dir",
    "verify:embedding-model": "node scripts/verify-embedding-model.mjs",
    "verify:setting-protocol": "node scripts/verify-setting-distillation-protocol.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.28.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/turndown": "^5.0.6",
    "@types/word-extractor": "^1.0.6",
    "@vitejs/plugin-react": "^4.3.0",
    "archiver": "^7.0.1",
    "date-fns": "^4.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "js-tiktoken": "^1.0.14",
    "lucide-react": "^0.454.0",
    "openai": "^4.67.0",
    "rcedit": "^5.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.13.0",
    "simple-git": "^3.25.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "zustand": "^5.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "chardet": "^2.1.0",
    "iconv-lite": "^0.6.3",
    "mammoth": "^1.12.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "word-extractor": "^1.0.4"
  },
  "overrides": {
    "@huggingface/transformers": {
      "onnxruntime-node": "1.29.0",
      "onnxruntime-web": "1.29.0",
      "sharp": "0.35.4"
    }
  }
}
